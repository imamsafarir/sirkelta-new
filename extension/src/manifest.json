{
  "manifest_version": 3,
  "name": "Sirkelta WaSender",
  "short_name": "WaSender",
  "version": "1.0.0",
  "description": "Ekstensi Broadcast WhatsApp Resmi Sirkelta untuk WhatsApp Web - Personalisasi, Draf Pesan & Anti-Banned.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://web.whatsapp.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Sirkelta WaSender",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content/content-script.ts"],
      "css": ["src/content/content-style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["src/content/web-auth-bridge.ts"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "config.json",
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
